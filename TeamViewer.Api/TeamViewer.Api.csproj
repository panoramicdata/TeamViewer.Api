<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup>
<TargetFramework>net10.0</TargetFramework>
<ImplicitUsings>enable</ImplicitUsings>
<LangVersion>latest</LangVersion>
<GenerateDocumentationFile>true</GenerateDocumentationFile>
<IsPackable>true</IsPackable>

<!-- Package Metadata -->
<PackageId>TeamViewer.Api</PackageId>
<Description>A comprehensive .NET library for the TeamViewer REST API. Provides full API coverage including Users, Groups, Devices, Sessions, Meetings, Reports, Policies, and Remote Management.</Description>
<PackageLicenseExpression>MIT</PackageLicenseExpression>
<PackageProjectUrl>https://github.com/panoramicdata/TeamViewer.Api</PackageProjectUrl>
<RepositoryUrl>https://github.com/panoramicdata/TeamViewer.Api</RepositoryUrl>
<RepositoryType>git</RepositoryType>
<PackageTags>TeamViewer;API;REST;Remote;Desktop;Support;Remote-Management;IT;MSP</PackageTags>
<PackageReadmeFile>README.md</PackageReadmeFile>
<PackageIcon>Logo.png</PackageIcon>
<PackageReleaseNotes>Initial release with full TeamViewer API coverage.</PackageReleaseNotes>
</PropertyGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="TeamViewer.Api.Test" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="Logo.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<ItemGroup>
       <PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
		<PackageReference Include="Refit" />
		<PackageReference Include="Refit.HttpClientFactory" />
	</ItemGroup>
</Project>
